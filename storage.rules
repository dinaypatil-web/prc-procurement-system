rules_version = '2';
// ============================================================================
// PRC PROCUREMENT SYSTEM — FIREBASE STORAGE RULES
// USER-SCOPED STORAGE ACCESS: Users have isolated access to their uploaded files.
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidFile() {
      return request.resource.size < 25 * 1024 * 1024  // 25MB max
        && request.resource.contentType.matches('application/pdf|image/.*|application/vnd\\..*|application/msword|text/.*');
    }

    // User-scoped attachments & imports
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId) && (request.method == 'GET' || isValidFile());
    }

    // Global attachments fallback
    match /attachments/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId) && (request.method == 'GET' || isValidFile());
    }

    // Report exports
    match /reports/{userId}/{filename} {
      allow read, write: if isOwner(userId);
    }
  }
}
