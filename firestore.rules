rules_version = '2';
// ============================================================================
// PRC PROCUREMENT SYSTEM — FIRESTORE SECURITY RULES
// Seamless multi-user real-time synchronization across devices and workspaces
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared procurement workspace collections
    match /workspaces/{workspaceId}/{document=**} {
      allow read, write: if true;
    }

    // User-scoped collections
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // System settings & global data
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
