rules_version = '2';
// ============================================================================
// PRC PROCUREMENT SYSTEM — FIRESTORE SECURITY RULES
// Strict Per-User Data Isolation Strategy
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated User-scoped documents (Strictly private to each user)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Guest / unauthenticated fallback isolation
    match /users/guest/{document=**} {
      allow read, write: if request.auth == null;
    }

    // System settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for all other collections to block unauthorized cross-user access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
