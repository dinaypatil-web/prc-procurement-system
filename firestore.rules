rules_version = '2';
// ============================================================================
// PRC PROCUREMENT SYSTEM — FIRESTORE SECURITY RULES
// USER-SCOPED DATA ACCESS: Each authenticated user only has read/write access
// to their own data tree under /users/{userId}/...
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── USER PROFILE & USER SUBCOLLECTIONS ───────────────────
    // All user-scoped collections (prcs, allocations, rfqs, tcds, pods, vendors, notifications, activityLogs)
    // are stored under /users/{userId}/...
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{collection}/{docId} {
        allow read, write: if isOwner(userId);

        // Subcollections under documents (e.g. materials, history, etc.)
        match /{subCollection}/{subDocId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Legacy or global settings if any
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
  }
}
